# URL base da API Django (sem barra final)
# Em dev o proxy do Vite encaminha /api → localhost:8000
# Em produção aponte para o domínio real
VITE_API_BASE=

# PINs das turmas no formato TURMA:PIN,TURMA:PIN,...
# Cada par identifica uma turma e seu PIN de 4 dígitos.
# Exemplo: 6A:1001,6B:1002,7A:1003,7B:1004
# ATENÇÃO: mantenha este arquivo fora do controle de versão em produção.
VITE_PINS=6A:1001,6B:1002,7A:1003,7B:1004,8A:1005,8B:1006,9A:1007

# Turno padrão por turma (opcional — se omitido usa MANHA)
# Formato: TURMA:TURNO,TURMA:TURNO
# Turnos válidos: MANHA, TARDE, INTEGRAL
VITE_TURNOS=6A:MANHA,6B:MANHA,7A:MANHA,7B:TARDE,8A:TARDE,8B:TARDE,9A:INTEGRAL
