FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY packages ./packages
COPY frontend ./frontend
COPY app-alunos ./app-alunos
COPY app-cozinha ./app-cozinha
ARG API_ORIGIN
RUN test -n "$API_ORIGIN"
RUN npm ci --prefix frontend --no-audit --no-fund && VITE_API_URL="$API_ORIGIN/api" npm run build --prefix frontend
RUN npm ci --prefix app-alunos --no-audit --no-fund && VITE_API_BASE="$API_ORIGIN" npm run build --prefix app-alunos
RUN npm ci --prefix app-cozinha --no-audit --no-fund && VITE_API_BASE="$API_ORIGIN" npm run build --prefix app-cozinha

FROM caddy:2-alpine
COPY --from=build /app/frontend/dist /srv/painel
COPY --from=build /app/app-alunos/dist /srv/alunos
COPY --from=build /app/app-cozinha/dist /srv/cozinha
COPY deploy/Caddyfile /etc/caddy/Caddyfile
