{
    email {$ACME_EMAIL}
}

{$API_HOST} {
    encode zstd gzip
    request_body {
        max_size 6MB
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    reverse_proxy api:8000
    log {
        output stdout
        format json
    }
}
