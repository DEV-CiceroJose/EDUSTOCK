# Exemplo para o ambiente do processo Django (não é carregado automaticamente).
# Substitua os domínios e preencha as credenciais antes de iniciar o serviço.
APP_ENV=production
DEBUG=False
SECRET_KEY=
PIN_LOOKUP_SECRET=
DATABASE_URL=
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://estoque.example.com,https://alunos.example.com,https://cozinha.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
TRUSTED_PROXY_COUNT=1
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=False
# Opcional: sem Redis, as migrations criam o cache compartilhado no PostgreSQL.
REDIS_URL=

# Variáveis de BUILD: dashboard e PWAs, respectivamente.
VITE_API_URL=https://api.example.com/api
VITE_API_BASE=https://api.example.com
