# Copiar para deploy/.env SOMENTE no servidor. Não versionar o arquivo preenchido.
# Usar segredos diferentes, aleatórios. Senha do banco: caracteres hexadecimais
# para permitir uso seguro na URL. Preservar os segredos ao atualizar o sistema.
POSTGRES_PASSWORD=
SECRET_KEY=
PIN_LOOKUP_SECRET=
API_HOST=api.example.com
PAINEL_HOST=painel.example.com
ALUNOS_HOST=alunos.example.com
COZINHA_HOST=cozinha.example.com
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=False
DEMO_MODE=False
