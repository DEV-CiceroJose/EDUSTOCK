# Copiar para deploy/.env SOMENTE na VPS. Nunca versionar o arquivo preenchido.
# Preserve SECRET_KEY e PIN_LOOKUP_SECRET entre atualizações.
# Use somente hexadecimal aqui, pois o valor entra na URL de conexão.
POSTGRES_PASSWORD=
SECRET_KEY=
PIN_LOOKUP_SECRET=

# Host público da API na Hostinger, sem esquema nem caminho.
API_HOST=api.seudominio.com.br
ACME_EMAIL=infra@seudominio.com.br

# Origens HTTPS completas dos três Static Sites da Render.
DASHBOARD_ORIGIN=https://edustock-dashboard.onrender.com
ALUNOS_ORIGIN=https://edustock-alunos.onrender.com
COZINHA_ORIGIN=https://edustock-cozinha.onrender.com

SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=False
LOGIN_TOKEN_TTL_HORAS=12
OPERACAO_TOKEN_TTL_HORAS=12
IMAGE_TAG=local

# Backup externo via rclone. Configure o remoto fora do repositório.
BACKUP_DIR=/var/backups/edustock
BACKUP_REMOTE=edustock-offsite:edustock/producao
BACKUP_RETENTION_DAYS=14
